rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedPasswordOrEmail() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.email_verified == true
      );
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveWorkspaceUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.username is string && data.username in ['admin', 'niraj']
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.role is string && data.role in ['admin', 'user']
        && data.status is string && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['username', 'createdAt'])
        && data.keys().hasOnly(['username', 'createdAt'])
        && data.username is string && data.username == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'type', 'title', 'category', 'amount', 'costAmount',
          'quantity', 'inventoryItemId', 'paymentMethod', 'notes', 'transactionDate',
          'createdByUid', 'createdByUsername', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'type', 'title', 'category', 'amount', 'costAmount',
          'quantity', 'inventoryItemId', 'paymentMethod', 'notes', 'transactionDate',
          'createdByUid', 'createdByUsername', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.workspaceId is string && data.workspaceId == 'primary_ledger'
        && data.type is string && data.type in ['sale', 'purchase', 'petty_cash_expense', 'operating_expense', 'petty_cash_topup', 'fund_deposit']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.amount is number && data.amount > 0
        && data.costAmount is number && data.costAmount >= 0
        && data.quantity is number && data.quantity >= 0
        && data.inventoryItemId is string && data.inventoryItemId.size() <= 128
        && (data.inventoryItemId == '' || isValidId(data.inventoryItemId))
        && data.paymentMethod is string && data.paymentMethod in ['petty_cash', 'bank', 'cash', 'card']
        && data.notes is string && data.notes.size() <= 500
        && data.transactionDate is string && data.transactionDate.size() >= 8 && data.transactionDate.size() <= 32 && data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidId(data.createdByUid)
        && data.createdByUsername is string && data.createdByUsername in ['admin', 'niraj']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'sku', 'name', 'category', 'totalStockLevel',
          'stockRemaining', 'reorderLevel', 'unitCost', 'unitPrice', 'unitLabel',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'sku', 'name', 'category', 'totalStockLevel',
          'stockRemaining', 'reorderLevel', 'unitCost', 'unitPrice', 'unitLabel',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.workspaceId is string && data.workspaceId == 'primary_ledger'
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.totalStockLevel is number && data.totalStockLevel >= 0
        && data.stockRemaining is number && data.stockRemaining >= 0
        && data.reorderLevel is number && data.reorderLevel >= 0
        && data.unitCost is number && data.unitCost >= 0
        && data.unitPrice is number && data.unitPrice >= 0
        && data.unitLabel is string && data.unitLabel.size() >= 1 && data.unitLabel.size() <= 20
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudgetConfig(data) {
      return data.keys().hasAll([
          'workspaceId', 'advertisingPct', 'brandingPct', 'reinvestmentPct',
          'savingsPct', 'pettyCashOpeningFloat', 'openingFundBalance', 'currencySymbol', 'resetVersion', 'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'advertisingPct', 'brandingPct', 'reinvestmentPct',
          'savingsPct', 'pettyCashOpeningFloat', 'openingFundBalance', 'currencySymbol', 'resetVersion', 'updatedByUid', 'updatedAt'
        ])
        && data.workspaceId is string && data.workspaceId == 'primary_ledger'
        && data.advertisingPct is number && data.advertisingPct >= 0 && data.advertisingPct <= 100
        && data.brandingPct is number && data.brandingPct >= 0 && data.brandingPct <= 100
        && data.reinvestmentPct is number && data.reinvestmentPct >= 0 && data.reinvestmentPct <= 100
        && data.savingsPct is number && data.savingsPct >= 0 && data.savingsPct <= 100
        && (data.advertisingPct + data.brandingPct + data.reinvestmentPct + data.savingsPct) == 100
        && data.pettyCashOpeningFloat is number && data.pettyCashOpeningFloat >= 0
        && data.openingFundBalance is number && data.openingFundBalance >= 0
        && data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8
        && data.resetVersion is number && data.resetVersion >= 1
        && isValidId(data.updatedByUid)
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedPasswordOrEmail()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().username == 'admin' && incoming().role == 'admin' && request.auth.token.email == 'admin@ledgerflow.local') ||
          (incoming().username == 'niraj' && incoming().role == 'user' && request.auth.token.email == 'niraj@ledgerflow.local')
        );
      allow update: if isVerifiedPasswordOrEmail()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'status', 'updatedAt'])) ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list: if false;
      allow create: if isVerifiedPasswordOrEmail()
        && isValidId(adminId)
        && request.auth.uid == adminId
        && isValidAdminMarker(incoming())
        && incoming().createdAt == request.time
        && request.auth.token.email == 'admin@ledgerflow.local'
        && request.auth.token.firebase.sign_in_provider == 'password';
      allow update, delete: if false;
    }

    // Only admin can create, update, or delete transactions; common user can only view
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && isActiveWorkspaceUser();
      allow list: if isVerifiedPasswordOrEmail() && resource.data.workspaceId == 'primary_ledger';
      allow create: if isVerifiedPasswordOrEmail()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && isAdmin()
        && incoming().id == transactionId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdByUsername == 'admin'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedPasswordOrEmail()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByUsername == existing().createdByUsername
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'title', 'category', 'amount', 'costAmount', 'quantity',
          'inventoryItemId', 'paymentMethod', 'notes', 'transactionDate', 'updatedAt'
        ]);
      allow delete: if isVerifiedPasswordOrEmail() && isValidId(transactionId) && isAdmin();
    }

    // Only admin can create, update, or delete inventory items; common user can only view
    match /inventory/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && isActiveWorkspaceUser();
      allow list: if isVerifiedPasswordOrEmail() && resource.data.workspaceId == 'primary_ledger';
      allow create: if isVerifiedPasswordOrEmail()
        && isValidId(itemId)
        && isValidInventoryItem(incoming())
        && isAdmin()
        && incoming().id == itemId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedPasswordOrEmail()
        && isValidId(itemId)
        && isValidInventoryItem(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sku', 'name', 'category', 'totalStockLevel', 'stockRemaining',
          'reorderLevel', 'unitCost', 'unitPrice', 'unitLabel', 'updatedAt'
        ]);
      allow delete: if isVerifiedPasswordOrEmail() && isValidId(itemId) && isAdmin();
    }

    // Only admin can create or update budget configuration; common user can only view
    match /budget_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && isActiveWorkspaceUser();
      allow list: if isVerifiedPasswordOrEmail() && resource.data.workspaceId == 'primary_ledger';
      allow create: if isVerifiedPasswordOrEmail()
        && isValidId(configId)
        && isValidBudgetConfig(incoming())
        && isAdmin()
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedPasswordOrEmail()
        && isValidId(configId)
        && isValidBudgetConfig(incoming())
        && isAdmin()
        && incoming().workspaceId == existing().workspaceId
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'advertisingPct', 'brandingPct', 'reinvestmentPct', 'savingsPct',
          'pettyCashOpeningFloat', 'openingFundBalance', 'currencySymbol', 'resetVersion', 'updatedByUid', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
