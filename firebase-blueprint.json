{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace user account restricted to admin or user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Login username",
          "enum": ["admin", "user"],
          "minLength": 3,
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable name",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "description": "Access control role",
          "enum": ["admin", "user"]
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "username", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin role lookup document keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "enum": ["admin"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["username", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Accounting ledger entry for sales, purchases, petty cash expenses, operating expenses, or petty cash top-ups",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "enum": ["primary_ledger"],
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "enum": ["sale", "purchase", "petty_cash_expense", "operating_expense", "petty_cash_topup", "fund_deposit"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary amount of the transaction"
        },
        "costAmount": {
          "type": "number",
          "description": "Cost of goods sold for sales transactions"
        },
        "quantity": {
          "type": "number",
          "description": "Units involved when linked to an inventory item"
        },
        "inventoryItemId": {
          "type": "string",
          "maxLength": 128,
          "description": "Linked inventory SKU document ID or empty string"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["petty_cash", "bank", "cash", "card"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "transactionDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUsername": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "type",
        "title",
        "category",
        "amount",
        "costAmount",
        "quantity",
        "inventoryItemId",
        "paymentMethod",
        "notes",
        "transactionDate",
        "createdByUid",
        "createdByUsername",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Stocked product or supply item tracked for inventory levels and margins",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "enum": ["primary_ledger"],
          "maxLength": 32
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "totalStockLevel": {
          "type": "number"
        },
        "stockRemaining": {
          "type": "number"
        },
        "reorderLevel": {
          "type": "number"
        },
        "unitCost": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "unitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "sku",
        "name",
        "category",
        "totalStockLevel",
        "stockRemaining",
        "reorderLevel",
        "unitCost",
        "unitPrice",
        "unitLabel",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetConfig": {
      "title": "BudgetConfig",
      "description": "Net income allocation percentages and petty cash opening configuration",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["primary_ledger"],
          "maxLength": 32
        },
        "advertisingPct": {
          "type": "number"
        },
        "brandingPct": {
          "type": "number"
        },
        "reinvestmentPct": {
          "type": "number"
        },
        "savingsPct": {
          "type": "number"
        },
        "pettyCashOpeningFloat": {
          "type": "number"
        },
        "openingFundBalance": {
          "type": "number"
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "resetVersion": {
          "type": "number"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "advertisingPct",
        "brandingPct",
        "reinvestmentPct",
        "savingsPct",
        "pettyCashOpeningFloat",
        "openingFundBalance",
        "currencySymbol",
        "resetVersion",
        "updatedByUid",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles for admin and user accounts"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role verification documents"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "All accounting transactions including sales, purchases, petty cash, and expenses"
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Tracked inventory items with total stock levels, remaining stock, and pricing"
    },
    "/budget_config/{configId}": {
      "schema": { "$ref": "#/entities/BudgetConfig" },
      "description": "Net income allocation configuration (10% advertising, 5% branding, 50% reinvestment, 35% savings)"
    }
  }
}
